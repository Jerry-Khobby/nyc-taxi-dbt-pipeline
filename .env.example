# Copy to .env and fill in. Never commit .env.
# Use letters, digits and underscores in usernames and passwords: they are
# embedded in connection URIs and SQL, where special characters break.

# Warehouse (Postgres superuser + the database dbt and ingestion use)
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=change_me
WAREHOUSE_DB=nyc_taxi

# Airflow metadata database
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me

# Metabase application database
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=change_me

# Airflow secrets
# Fernet key:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# JWT secret:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=

# Airflow web UI login
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=change_me

# On Linux, set to the output of `id -u`. Leave as is on Windows and macOS.
AIRFLOW_UID=50000

# Host ports (change if already in use)
POSTGRES_HOST_PORT=5432
AIRFLOW_HOST_PORT=8080
METABASE_HOST_PORT=3000
